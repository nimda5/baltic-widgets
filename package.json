{
  "name": "baltic-widgets",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node services/server.mjs",
    "update": "node scripts/update-data.mjs",
    "update:current": "node scripts/update-current-prices.mjs",
    "update:offline": "node scripts/update-data.mjs --offline",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview-static.mjs",
    "publish:data": "node scripts/publish-data.mjs",
    "generate:horoscope": "node scripts/generate-horoscope.mjs",
    "test": "node --test parsers/*.test.mjs services/*.test.mjs public/zodiac-icons.test.mjs",
    "generate:namedays": "node scripts/generate-namedays.mjs",
    "update:nameday-statistics": "node scripts/update-nameday-statistics.mjs",
    "test:namedays": "node --test parsers/namedays.test.mjs",
    "update:plan": "node scripts/update-data.mjs --plan",
    "update:prices": "node scripts/update-data.mjs --profile=prices",
    "update:daily": "node scripts/update-data.mjs --profile=daily",
    "update:weekly": "node scripts/update-data.mjs --profile=weekly",
    "update:monthly": "node scripts/update-data.mjs --profile=monthly",
    "update:full": "node scripts/update-data.mjs --profile=full"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "cheerio": "^1.2.0",
    "read-excel-file": "^9.3.14"
  }
}
